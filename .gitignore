# Local portable staging and scratch outputs
AuralPrimerPortable/
# Zipped portable output(s): create_portable.ps1 -ZipOutput writes
# AuralPrimerPortable.zip (and timestamped/variant siblings) next to the dir.
AuralPrimerPortable*.zip
.coverage
python/ingest/.coverage
python/ingest/coverage.xml
python/ingest/build/

# Scratch files (prevent recurrence of the 677GB tmp_pack bloat and stray
# scratch commits). These are deliberately broad for tmp_ prefixes but the
# legitimate committed fixtures live under assets/test_fixtures/ (see negations
# below), so they are never affected.
tmp_*
**/tmp_*

# ...but Windows and macOS match those two case-insensitively, so `tmp_*` also
# swallows TextMesh Pro's TMP_*.shader files. All 18 of them were silently kept
# out of the repo: this checkout had them on disk from the original import, so
# nothing looked wrong here, while a fresh clone built with no TMP shader at all
# and every glyph rendered as a solid magenta quad -- text vanishing with no
# error anywhere. Negated by path rather than by narrowing tmp_*, which is
# load-bearing (see the 677 GB note above).
!**/TextMesh Pro/Shaders/TMP_*
# Root-level scratch screenshots only (root-anchored so nested, intentionally
# committed images elsewhere are untouched).
/*.png
# Scratch AuralSongs dumped at the repo root by ad-hoc ingest/demucs runs.
# Root-anchored so the tracked fixtures under assets/test_fixtures/ are NOT
# ignored.
# Belt-and-braces: never ignore the committed test fixtures even if a broader
# pattern is added above.
!assets/test_fixtures/**
assets/test_fixtures/**/*.asd
assets/models/mr_mt3/
assets/models/yourmt3/
assets/models/piano_pti/
assets/models/piano_d3rm/
assets/models/drum_crnn/
assets/models/beat_this/
assets/models/rmvpe/

# Local agent/worktree scratch state
.claude/
.work/
.external/

# Ad-hoc command output and generated import products
tmp/
*.auralsong/
*.auralsong
!assets/test_fixtures/**/*.auralsong/
!assets/test_fixtures/**/*.auralsong/**

# Generated sidecar binaries are built by the packaging scripts.
apps/desktop/src-tauri/binaries/
apps/game/src-tauri/binaries/

# Local benchmark/research output. Keep committed manifests/docs, ignore run
# products and caches produced by local experiments.
benchmarks/drums/shootouts/runs/
benchmarks/piano/.cache/
benchmarks/piano/runs/
benchmarks/piano/refinement_runs/
benchmarks/piano/ableton_verification/
benchmarks/piano/LATEST_RUN.txt
benchmarks/piano/LATEST_REFINEMENT_RUN.txt
benchmarks/piano/psalm*_shootout_manifest.json
benchmarks/python/*.latest.json
benchmarks/rust/bench-rust-summary.json

# Python packaging outputs from sidecar builds.
python/ingest/dist*/

# Local large-binary caches: downloaded model checkpoints (e.g. mr_mt3 mt3.pth)
# and CUDA torch wheels. Not for VCS — fetched on demand per machine.
python/ingest/.mt3_checkpoints/
python/ingest/.wheelhouse/

# In-house drum-CRNN training output: checkpoints, ONNX exports, run logs.
# The harness (aural_ingest.training.drum_crnn) writes these to output_dir;
# keep them OUT of VCS even if someone points output_dir inside the repo.
python/ingest/**/drum_crnn_run*/
python/ingest/**/drum_crnn_smoke*/
python/ingest/src/aural_ingest/training/**/*.pt
python/ingest/src/aural_ingest/training/**/*.onnx

# Stray audio/PDF dropped at the repo root by ad-hoc runs (root-anchored so
# intentionally committed fixtures under subdirs are untouched).
/*.wav
/*.pdf

# Local idea/scratch material dropped at the repo root (not for VCS for now).
/00_Ideas_for_nashville_number_stuff/

# --- Unity MR client (UnityClient/) -------------------------------------
# Unity regenerates all of this from Assets/ + ProjectSettings/ + Packages/.
# It is large, churns on every editor launch, and is machine-specific, so it
# must never enter VCS. Patterns are unanchored so they apply at whatever
# depth the project sits (the folder name contains a space).
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/
Recordings/

# Visual Studio / Rider project files: regenerated from the package set.
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
.vs/
.idea/
.vscode/

# Unity build products and crash dumps.
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Asset-import and burst artefacts.
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
*.pdb.meta
*.mdb.meta

# Unity template + package sample content: ~109 MB of skyboxes, an onboarding
# video and baked lightmaps that ship with the MR Template and the XRI samples.
# None of it is ours, all of it is re-importable (Package Manager -> Samples),
# and we replace the template scene with our own. Keeping it out of history
# matters because git bloat is permanent without a rewrite.
UnityClient/**/Assets/MRTemplateAssets/
UnityClient/**/Assets/MRTemplateAssets.meta
UnityClient/**/Assets/Samples/
UnityClient/**/Assets/Samples.meta

# ...except the XR Hands visualiser, which is 2 MB and is not decoration: the
# rigged hand mesh is what the "show my hands" mode renders. Left ignored, a
# fresh clone builds a scene whose hand prefabs resolve to nothing, and the
# mode silently does nothing -- the same failure the TMP shaders had, where
# ignored-but-required assets produced magenta text on a clean checkout.
!UnityClient/**/Assets/Samples/
!UnityClient/**/Assets/Samples.meta
!UnityClient/**/Assets/Samples/XR Hands/
!UnityClient/**/Assets/Samples/XR Hands/**

# Offscreen UI renders written by RenderCheck.cs — verification output,
# regenerated on demand.
UnityClient/RenderChecks/
