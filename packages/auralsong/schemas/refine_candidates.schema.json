{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auralprimer.dev/schemas/refine_candidates.schema.json",
  "title": "AuralSong Refine Candidates",
  "description": "Pre-computed per-region candidate transcriptions produced by the ingest sidecar. Editor-time only: the runtime game never reads this file; it only feeds the Studio Refine workspace. Stored at features/refine_candidates.<instrument>.json (one file per instrument).",
  "type": "object",
  "required": ["version", "instrument", "song_duration_sec", "candidates", "regions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "instrument": {
      "type": "string",
      "enum": ["keys", "bass", "lead_guitar", "rhythm_guitar", "drums", "melodic"]
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline_signature": {
      "type": "string",
      "description": "Hash of the algorithm versions + parameters that produced this file. The Studio uses it to detect when a re-precompute has invalidated a stored refinement's auto_picked."
    },
    "song_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "candidates": {
      "type": "object",
      "description": "Map of candidate_id -> definition. The same set of candidates is offered for every region in this file.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/candidate_def" }
    },
    "regions": {
      "type": "array",
      "items": { "$ref": "#/definitions/region" }
    }
  },
  "definitions": {
    "note": {
      "type": "object",
      "required": ["t_on", "t_off", "pitch", "velocity"],
      "additionalProperties": false,
      "properties": {
        "t_on": { "type": "number", "minimum": 0 },
        "t_off": { "type": "number", "exclusiveMinimum": 0 },
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 }
      }
    },
    "candidate_def": {
      "type": "object",
      "required": ["label", "color"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "Hex color used as the UI tint for this candidate's diff overlay and swatch." },
        "params": {
          "type": "object",
          "description": "Parameters that produced this candidate. Free-form per candidate; used for provenance and re-precompute.",
          "additionalProperties": true
        }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "t_start", "t_end", "hot_spot_type", "confidence", "auto_picked", "candidate_scores", "candidate_notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "t_start": { "type": "number", "minimum": 0 },
        "t_end": { "type": "number", "exclusiveMinimum": 0 },
        "section_label": { "type": "string" },
        "hot_spot_type": {
          "type": "string",
          "enum": ["octave_ghost", "off_chord", "density_outlier", "bass_gap", "low_confidence", "clean", "manual"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "chord": { "type": "string", "description": "Active chord at the start of this region (e.g. 'Bb', 'F7'). Optional." },
        "auto_picked": { "type": "string", "minLength": 1, "description": "candidate_id with the highest score for this region." },
        "candidate_scores": {
          "type": "object",
          "description": "candidate_id -> score in 0..1.",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "candidate_notes": {
          "type": "object",
          "description": "candidate_id -> the notes that candidate produces for this region.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/note" }
          }
        }
      }
    }
  }
}
