{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auralprimer.app/schemas/feedpak/aural-fingering.schema.json",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later. AuralPrimer feedpak aural_fingering sidecar (aural/fingering.<role>.json).",
  "title": "AuralPrimer feedpak fingering sidecar",
  "type": "object",
  "required": ["instrument", "notes"],
  "additionalProperties": true,
  "properties": {
    "version": { "$ref": "#/$defs/semver" },
    "instrument": { "$ref": "#/$defs/instrumentRole" },
    "tuning": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0, "maximum": 127 }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    },
    "anchors": {
      "$comment": "Hand positions from an authored tab: index finger at `fret`, hand spanning `width` frets, from time `t`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "fret"],
        "additionalProperties": true,
        "properties": {
          "t": { "type": "number" },
          "fret": { "type": "integer", "minimum": 0, "maximum": 36 },
          "width": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "handshapes": {
      "$comment": "Chord shapes held from `t` to `t_end` (arpeggios included), lowest string first; -1 = string unused / no finger.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "frets"],
        "additionalProperties": true,
        "properties": {
          "t": { "type": "number" },
          "t_end": { "type": "number" },
          "name": { "type": "string" },
          "frets": { "type": "array", "items": { "type": "integer", "minimum": -1, "maximum": 36 } },
          "fingers": { "type": "array", "items": { "type": "integer", "minimum": -1, "maximum": 4 } }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "instrumentRole": {
      "type": "string",
      "enum": ["bass", "guitar", "rhythm_guitar", "lead_guitar", "keys", "vocals", "melodic"]
    },
    "note": {
      "type": "object",
      "required": ["t_on", "pitch"],
      "additionalProperties": true,
      "properties": {
        "t_on": { "type": "number", "minimum": 0 },
        "t_off": { "type": "number" },
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 0, "maximum": 127 },
        "string": { "type": "integer", "minimum": 0, "maximum": 8 },
        "fret": { "type": "integer", "minimum": 0, "maximum": 36 },
        "s": { "type": "integer", "minimum": 0, "maximum": 8 },
        "f": { "type": "integer", "minimum": 0, "maximum": 36 },
        "tech": { "$comment": "feedpak technique keys present on the note (pm, ho, po, sl, bn, vb, hm, ...).", "type": "object" },
        "chord": { "$comment": "Name of the chord the note belongs to.", "type": "string" },
        "finger": { "$comment": "Fretting finger from the chord template: 1 index .. 4 pinky.", "type": "integer", "minimum": 0, "maximum": 4 }
      },
      "anyOf": [
        { "required": ["string", "fret"] },
        { "required": ["string", "f"] },
        { "required": ["s", "fret"] },
        { "required": ["s", "f"] }
      ]
    }
  }
}
