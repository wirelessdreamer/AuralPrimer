# Normalize line endings in-repo.
# - Store text files with LF.
# - On checkout, Git will convert to your platform default unless you override core.autocrlf.
* text=auto eol=lf

# Explicitly treat common source/config as text
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.rs          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.css         text eol=lf
*.html        text eol=lf

# Shell scripts
*.sh          text eol=lf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Python
*.py          text eol=lf

# Treat binaries as binary (no end-of-line conversion)
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.zip         binary
*.pdf         binary
*.wav         binary
*.mp3         binary
*.ogg         binary
*.mid         binary
*.exe         binary
*.dll         binary
*.pdb         binary
*.d           binary

# --- Unity macros -------------------------------------------------------
# Git only honours [attr] macro definitions in the TOP-LEVEL .gitattributes.
# The Unity project's own .gitattributes uses these macros, so they are defined
# here; leaving them in the subdirectory made git warn "not allowed" on every
# command. The usage lines stay with the Unity project, where they belong.
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml
